Interface MainWindow:
    Title "Tic Tac Toe - Standard"
    Size 520 by 650
    Background "#15171C"

    Card app_card:
        Position 28 by 24
        Size 464 by 590
        Background "#20242B"
        Foreground "#343A44"
        Corner radius 18
    End

    Text title_text:
        Text "Tic Tac Toe"
        Position 64 by 52
        Size 390 by 48
        Font size 32
        Foreground "#F3F7F4"
    End

    Text subtitle_text:
        Text "Made entirely with Standard + Standard UI"
        Position 64 by 100
        Size 390 by 30
        Font size 14
        Foreground "#96A19B"
    End

    Text status_text:
        Text "X's turn"
        Position 64 by 145
        Size 390 by 36
        Font size 19
        Foreground "#78F28B"
    End

    Card board_card:
        Position 64 by 195
        Size 390 by 390
        Background "#181B20"
        Foreground "#343A44"
        Corner radius 14
    End

    Button cell_1:
